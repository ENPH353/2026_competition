<?xml version="1.0"?>
<sdf version="1.8">
    <model name="wind_sock">
      <!-- Force Gazebo to ignore collisions between links in this specific model -->
      <self_collide>false</self_collide>
      <static>false</static>
      
      <!-- Anchor moved up to Z=1.97 -->
      <link name="anchor">
        <pose>0 0 1.97 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00087</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.00087</iyy>
            <iyz>0.0</iyz>
            <izz>0.00166</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.02</size>
            </box>
          </geometry>
        </collision>
      </link>
      <joint name="anchor_joint" type="fixed">
        <parent>world</parent>
        <child>anchor</child>
      </joint>

      <!-- SPHERE 1 -->
      <link name="sphere_1">
        <pose>0 0 1.93 0 0 0</pose>
        <enable_wind>true</enable_wind>
        <inertial>
          <mass>0.0005</mass>
          <inertia>
            <ixx>5.0e-5</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>5.0e-5</iyy>
            <iyz>0.0</iyz>
            <izz>5.0e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0 0 1.0</ambient>
            <diffuse>.421 0.225 0.0 1.0</diffuse>
            <specular>1.0 0 0 1.0</specular>
          </material>
        </visual>
      </link>
      <joint name="sphere_1_joint" type="universal">
        <parent>anchor</parent>
        <child>sphere_1</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-1.5</lower><upper>1.5</upper></limit>
          
        </axis>
        <axis2>
          <xyz>0 1 0</xyz>
          <limit><lower>-1.5</lower><upper>1.5</upper></limit>
          
        </axis2>
        
      </joint>

      <!-- SPHERE 2 -->
      <link name="sphere_2">
        <pose>0 0 1.89 0 0 0</pose>
        <enable_wind>true</enable_wind>
        <inertial>
          <mass>0.0005</mass>
          <inertia>
            <ixx>5.0e-5</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>5.0e-5</iyy>
            <iyz>0.0</iyz>
            <izz>5.0e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
