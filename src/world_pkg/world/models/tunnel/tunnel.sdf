<?xml version="1.0"?>
<sdf version="1.8">
    <model name="tunnel">
        <static>true</static>
        <link name="tunnel_link">
            <collision name="collision">
                <pose>0 0 0 0 0 1.57</pose>
                <geometry>
                    <mesh>
                        <uri>tunnel.dae</uri>
                        <scale>20 20 20</scale>
                    </mesh>
                </geometry>
            </collision>

            <visual name="visual">
                <pose>0 0 0 0 0 1.57</pose>
                <cast_shadows>false</cast_shadows>
                <transparency>0.0</transparency>
                <geometry>
                    <mesh>
                        <uri>tunnel.dae</uri>
                        <scale>20 20 20</scale>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1 1 1 1</diffuse>
                    <emissive>0.5 0.5 0.5 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>brick.png</albedo_map>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </link>
    </model>
</sdf>